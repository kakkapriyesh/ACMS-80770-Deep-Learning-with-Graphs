[flake8]
max-line-length = 88
extend-ignore = 
    # See https://github.com/PyCQA/pycodestyle/issues/373
    E203,
    # Black handles this
    E501,
    # Conflicts with Black
    W503,
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    venv,
    .venv,
    build,
    dist,
    *.egg-info,
per-file-ignores =
    __init__.py:F401
max-complexity = 10