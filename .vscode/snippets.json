            "    main()"
        ],
        "description": "Python main function"
    },
    "Python Test Function": {
        "prefix": "test",
        "body": [
            "def test_${1:function_name}():",
            "    \"\"\"Test ${2:description}.\"\"\"",
            "    # Arrange",
