            "",
            "    # Act",
            "    ${4:pass}",
            "",
            "    # Assert",
            "    ${5:assert True}"
        ],
        "description": "Python test function with AAA pattern"
    },
    "Python Try-Except": {
        "prefix": "try",
        "body": [
            "try:",
            "    ${1:pass}",
            "except ${2:Exception} as e:",
            "    ${3:print(f\"Error: {e}\")}"
        ],
        "description": "Python try-except block"
    },
    "Python Dataclass": {
        "prefix": "dataclass",
        "body": [
            "from dataclasses import dataclass",
            "",
            "",
            "@dataclass",
